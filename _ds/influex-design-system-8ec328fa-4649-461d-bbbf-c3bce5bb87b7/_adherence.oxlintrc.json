{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "ApplyForm.jsx",
              "ApplyWizard.jsx",
              "CEOIntro.jsx",
              "Closing.jsx",
              "DTAffordable.jsx",
              "DTCost.jsx",
              "DTEvolving.jsx",
              "DTExpect.jsx",
              "DTFaq.jsx",
              "DTHero.jsx",
              "DTIconsStrip.jsx",
              "DTNav.jsx",
              "DTOtherworld.jsx",
              "DTPackages.jsx",
              "DTPerfectFor.jsx",
              "DTPricingHow.jsx",
              "DTSocial.jsx",
              "DTTweaks.jsx",
              "DTWeServe.jsx",
              "DTWhich.jsx",
              "DTWhyCreate.jsx",
              "FAQ.jsx",
              "FitAssessment.jsx",
              "Hero.jsx",
              "HowItWorks.jsx",
              "Nav.jsx",
              "Outcomes.jsx",
              "PartnerGrid.jsx",
              "PartnersCTA.jsx",
              "PartnersHero.jsx",
              "PartnersTweaks.jsx",
              "Positioning.jsx",
              "Pricing.jsx",
              "Standard.jsx",
              "Steps.jsx",
              "TrustedBy.jsx",
              "Tweaks.jsx",
              "WhoFor.jsx",
              "admin.jsx",
              "app.jsx",
              "canvas.jsx",
              "dashboard.jsx",
              "login.jsx",
              "state.jsx",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--cream-1",
      "--cream-2",
      "--cream-3",
      "--danger",
      "--font-mono",
      "--font-ui",
      "--gold-1",
      "--gold-2",
      "--gold-deep",
      "--ink-0",
      "--ink-1",
      "--ink-2",
      "--ink-3",
      "--ink-4",
      "--line",
      "--line-faint",
      "--line-strong",
      "--r-1",
      "--r-2",
      "--r-3",
      "--r-4",
      "--shadow-glow",
      "--success"
    ],
    "tokenKinds": {
      "--ink-0": "color",
      "--ink-1": "color",
      "--ink-2": "color",
      "--ink-3": "color",
      "--ink-4": "color",
      "--cream-1": "color",
      "--cream-2": "color",
      "--cream-3": "color",
      "--gold-1": "color",
      "--gold-2": "color",
      "--gold-deep": "color",
      "--line-faint": "color",
      "--line": "color",
      "--line-strong": "color",
      "--shadow-glow": "shadow",
      "--danger": "color",
      "--success": "color",
      "--font-ui": "font",
      "--font-mono": "font",
      "--r-1": "spacing",
      "--r-2": "spacing",
      "--r-3": "spacing",
      "--r-4": "spacing"
    },
    "fontFamilies": []
  }
}